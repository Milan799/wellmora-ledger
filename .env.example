# ==============================================================================
# Wellmora Ledger - Environment Configuration Template
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace with your production MongoDB URI or local connection string
MONGODB_URI=mongodb://localhost:27017/wellmora_ledger

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Initial Administrative User (Created on first startup only if no admin exists)
ADMIN_USERNAME=WellmoraEnterprise
ADMIN_PASSWORD=ChangeThisPassword123!
ADMIN_NAME=Wellmora Enterprise
ADMIN_EMAIL=admin@wellmoraenterprise.com

